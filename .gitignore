# Go
/hub/bin/
*.test
*.out

# Segredos — nunca versionar
*.p8
*.pem
*.key
secrets/
.env
.env.*

# macOS / Xcode
.DS_Store
/app/**/xcuserdata/
/app/**/*.xcuserstate
DerivedData/

# Credenciais locais (hub.env, key.p8 etc) — mas os templates *.example
# versionam normalmente (Fase 5, docs/12-deploy-zimaos.md). Precisa ser
# `/config/*` (não `/config/`): excluir o DIRETÓRIO impede git de reconsiderar
# arquivos dentro dele mesmo com "!", só excluir os arquivos permite a
# negação abaixo.
/config/*
!/config/*.example
/app/build/

# Artefato local de tooling (skill copiada), não faz parte do projeto
/skills/

# Assinatura local (Team ID) — cada dev usa o seu; template em Local.xcconfig.example
/app/Local.xcconfig

# .xcodeproj é gerado pelo xcodegen (project.yml é a fonte da verdade) — rode `xcodegen generate`
/app/CutuqueApp.xcodeproj/
# Irmão gerado por project.testes.yml, para rodar a suíte sem o runtime do watchOS
/app/CutuqueAppTestes.xcodeproj/

# Brainstorming visual (superpowers) — mockups locais
.superpowers/

# Estado do hub (volume do container): device tokens, sessões e — desde a aba
# Máquinas — as CHAVES PRIVADAS ssh geradas pelo hub em data/machines/keys.
# Nada disso pode ir para o repositório.
/data/
